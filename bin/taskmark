#!/usr/bin/env python3
"""Launcher used by hooks.json — works no matter what the session's cwd is."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from taskmark.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
